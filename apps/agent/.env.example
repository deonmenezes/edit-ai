# Copy to .env and fill in what you need. Nothing here is required to boot the
# editor, but setup.ts skips whatever it cannot find, so a missing key shows up
# as a capability quietly absent rather than an error.

# --- models: set at least one, or setup has nothing to run the agent on -------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# NVIDIA is registered as an OpenAI-compatible provider rather than a standard
# one, so it needs no base URL of its own.
NVIDIA_API_KEY=

# Any other OpenAI-compatible endpoint. All three must be set together; setup
# ignores the block unless the models list is present.
# Names the provider; setup falls back to "compatible" only when it is absent,
# so an empty value registers the provider under an empty name.
# OPENAI_COMPATIBLE_NAME=compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODELS=

# --- sandbox ------------------------------------------------------------------

# Without this the agent still runs, but `exec` has nowhere to execute and the
# instructions that tell it to use a sandbox become dead text.
DAYTONA_API_KEY=

# Where the ffmpeg media workbench (packages/ffmpeg-sandbox) serves MCP. Setup
# probes its /health endpoint and attaches it only when it answers, so a stopped
# server is skipped with a hint rather than registered broken. Same trap as
# EDITAI_MCP_URL: setup falls back to the default only when the variable is
# absent, so leave it commented unless the server is somewhere else.
# FFMPEG_SANDBOX_URL=http://localhost:8931/mcp

# --- catalog connectors -------------------------------------------------------

# Comma separated TrueForge catalog servers to attach alongside the timeline
# tools. Commented out rather than left empty: setup falls back to the default
# only when the variable is absent, so EDITAI_CONNECTORS= attaches nothing at
# all instead of the documented exa. Uncomment to add a connector, and set its
# credential below first.
# EDITAI_CONNECTORS=exa,bright-data

# Header-auth connectors take their credential from <NAME>_MCP_HEADER, where the
# name is the catalog name uppercased with dashes as underscores. The whole
# header line is the value, not just the token. A connector whose variable is
# missing is skipped with a warning; one whose token is wrong attaches and then
# fails every call, so check auth_status rather than the connector list.
# Commented out rather than filled with a placeholder: setup only checks that
# the line exists, so a plausible-looking fake passes and registers the
# connector with a token that fails every call, which is the failure the note
# above warns about. An absent variable is skipped cleanly instead.
# BRIGHT_DATA_MCP_HEADER="Authorization: Bearer <your-token>"
# GITHUB_MCP_HEADER="Authorization: Bearer <your-token>"

# OAuth connectors such as linear need nothing here: the harness registers
# itself as a client and the run pauses with an authorize URL.

# --- harness and agent --------------------------------------------------------

# setup refuses to POST keys to a non-localhost host over plaintext HTTP.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_TOKEN=

EDITAI_AGENT_NAME=editai
EDITAI_AGENT_PORT=8941

# Same trap as EDITAI_CONNECTORS: setup derives this from EDITAI_AGENT_PORT only
# when the variable is absent, so an empty value registers the timeline server
# under an empty URL. Leave it commented unless the server is somewhere else.
# EDITAI_MCP_URL=http://localhost:8941/mcp

# Pin a specific model instead of letting setup choose. Empty is safe here:
# it is read with a truthiness check, not a nullish default.
EDITAI_MODEL=

# Where the video-editing skill is fetched from. Point these at a fork or a
# branch when working on the skill itself.
EDITAI_SKILL_REPO=https://github.com/deonmenezes/edit-ai
EDITAI_SKILL_REF=main
