# Copy to .env and fill in what you need. Nothing here is required to boot the
# editor, but setup.ts skips whatever it cannot find, so a missing key shows up
# as a capability quietly absent rather than an error.

# --- models: set at least one, or setup has nothing to run the agent on -------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# NVIDIA is registered as an OpenAI-compatible provider rather than a standard
# one, so it needs no base URL of its own.
NVIDIA_API_KEY=

# Any other OpenAI-compatible endpoint. All three must be set together; setup
# ignores the block unless the models list is present.
OPENAI_COMPATIBLE_NAME=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODELS=

# --- sandbox ------------------------------------------------------------------

# Without this the agent still runs, but `exec` has nowhere to execute and the
# instructions that tell it to use a sandbox become dead text.
DAYTONA_API_KEY=

# --- catalog connectors -------------------------------------------------------

# Comma separated TrueForge catalog servers to attach alongside the timeline
# tools. Defaults to exa (keyless web search) when unset.
EDITAI_CONNECTORS=exa,bright-data

# Header-auth connectors take their credential from <NAME>_MCP_HEADER, where the
# name is the catalog name uppercased with dashes as underscores. The whole
# header line is the value, not just the token. A connector whose variable is
# missing is skipped with a warning; one whose token is wrong attaches and then
# fails every call, so check auth_status rather than the connector list.
BRIGHT_DATA_MCP_HEADER="Authorization: Bearer your-bright-data-api-token"
# GITHUB_MCP_HEADER="Authorization: Bearer ghp_..."

# OAuth connectors such as linear need nothing here: the harness registers
# itself as a client and the run pauses with an authorize URL.

# --- harness and agent --------------------------------------------------------

# setup refuses to POST keys to a non-localhost host over plaintext HTTP.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_TOKEN=

EDITAI_AGENT_NAME=editai
EDITAI_AGENT_PORT=8941
EDITAI_MCP_URL=
EDITAI_MODEL=

# Where the video-editing skill is fetched from. Point these at a fork or a
# branch when working on the skill itself.
EDITAI_SKILL_REPO=https://github.com/deonmenezes/edit-ai
EDITAI_SKILL_REF=main
